+
+    source = '\n\n"But wait..." she asked, "are you sure?"'
+    result = backend.phonemize(source, voice="en-us")
+
+    assert result
+
+    batch_calls = [
+        call for call in backend._runtime.calls if call[0] == "phonemize_many"
+    ]
+    assert batch_calls
+
+    texts, selected_voice = batch_calls[0][1]
